{
  "apps": [{
    "name": "ingress-guard",
    "cwd": "/srv/apps/ingress-guard",
    "script": "/opt/bun/bin/bun",
    "args": "--env-file=/srv/apps/ingress-guard/.env apps/bot/src/main.ts",
    "interpreter": "none",
    "instances": 1,
    "exec_mode": "fork",
    "watch": false,
    "autorestart": true,
    "min_uptime": "10s",
    "max_restarts": 10,
    "exp_backoff_restart_delay": 1000,
    "kill_timeout": 15000,
    "max_memory_restart": "280M",
    "time": true,
    "env": { "NODE_ENV": "production" }
  }]
}
