# Use a dedicated test bot first. Replace this placeholder with a BotFather token.
BOT_TOKEN=replace_with_your_bot_token
# All three paths must be absolute. Create private data and temporary directories.
DATABASE_PATH=/absolute/path/to/xm-gatekeeper/data/guard.sqlite
ASSETS_DIR=/absolute/path/to/xm-gatekeeper/assets
BOARD_TEMP_DIR=/absolute/path/to/xm-gatekeeper/tmp
ASSET_STORAGE=local
MAX_ACTIVE_SESSIONS=200
MAX_RENDER_QUEUE=20
MAX_OUTBOX_PENDING=500
LOG_LEVEL=info

# Optional HTTPS webhook and self-hosted Cap Mini App; enable all five together.
# Generate independent URL-safe secrets; do not use these example labels as secrets.
# WEBHOOK_URL=https://bot.example.com/tg/webhook
# WEBHOOK_SECRET=replace_with_a_random_url_safe_secret_at_least_24_chars
# WEBHOOK_PORT=8788
# CAP_PUBLIC_URL=https://bot.example.com/guard/verify
# CAP_SECRET=replace_with_a_random_url_safe_secret_at_least_32_chars
